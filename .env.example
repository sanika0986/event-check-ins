# Copy to .env and edit
PORT=3000
# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite file location (mount a persistent volume in production)
DATABASE_FILE=./data/eventcheck.db
# Public base URL (used in links)
APP_URL=http://localhost:3000
# Set to production when deployed (hides dev reset links, enables Secure cookies)
NODE_ENV=development
# Set true when running behind a reverse proxy (nginx, Render, Fly, Railway...)
TRUST_PROXY=false
